# Persistent Terminal MCP Server Configuration

# MCP Server Port (for stdio transport, this is not used)
# MCP_PORT=3000

# REST API Server Port
REST_PORT=3001

# Auto-start REST API Server when MCP server starts
AUTO_START_REST_SERVER=true

# REST API Server Host (0.0.0.0 to listen on all interfaces)
REST_HOST=0.0.0.0

# Auto-start Terminal UI when REST server starts
AUTO_START_TERMINAL_UI=true

# Auto-open browser for Terminal UI (true/false, default: false to avoid issues in server environments)
AUTO_OPEN_BROWSER=false

# Web UI Server Host (0.0.0.0 to listen on all interfaces)
WEB_UI_HOST=0.0.0.0

# Terminal Configuration
MAX_BUFFER_SIZE=10000
SESSION_TIMEOUT=86400000

# Default Shell (leave empty for system default)
# DEFAULT_SHELL=/bin/bash

# Terminal Dimensions
DEFAULT_COLS=80
DEFAULT_ROWS=24

# Logging Level (error, warn, info, debug)
LOG_LEVEL=info

# Enable Debug Mode
# DEBUG=true
